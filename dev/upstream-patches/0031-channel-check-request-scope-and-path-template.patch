+package upstream
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"testing"
+
+	"workbuddy2api/internal/auth"
+)
+
+func TestConsolePreferredModelMissingRetriesPrimary(t *testing.T) {
+	var paths []string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		paths = append(paths, r.URL.Path)
+		if r.URL.Path == chatConsolePath {
+			w.WriteHeader(http.StatusBadRequest)
+			io.WriteString(w, `{"code":11102,"msg":"model [deepseek-v4.1-flash] service info not found"}`)
+			return
+		}
+		io.WriteString(w, "data: [DONE]\n\n")
+	}))
+	defer srv.Close()
+	c := New()
+	c.ChatBaseCN = srv.URL
+	c.markChannelBlocked("u1")
+	a := &auth.Auth{UID: "u1", AccessToken: "test", ExpiresAt: 9999999999}
+	rc, status, raw, err := c.ChatStream(a, []byte(`{"model":"deepseek-v4.1-flash","messages":[{"role":"user","content":"hi"}]}`), "", ChatMeta{})
+	if rc != nil {
+		rc.Close()
+	}
+	if err != nil || status != http.StatusOK {
+		t.Fatalf("primary remained usable: status=%d raw=%s err=%v", status, raw, err)
+	}
+	if !reflect.DeepEqual(paths, []string{chatConsolePath, chatCompletionsPath}) {
+		t.Fatalf("paths=%v", paths)
+	}
+}
+
+func TestConsolePreferredKeepsPrimaryModelError(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusBadRequest)
+		io.WriteString(w, `{"code":11102,"msg":"model [deepseek-v4.1-flash] service info not found"}`)
+	}))
+	defer srv.Close()
+	c := New()
+	c.ChatBaseCN = srv.URL
+	c.markChannelBlocked("u1")
+	a := &auth.Auth{UID: "u1", AccessToken: "test", ExpiresAt: 9999999999}
+	_, _, _, err := c.ChatStream(a, []byte(`{"model":"deepseek-v4.1-flash","messages":[{"role":"user","content":"hi"}]}`), "", ChatMeta{})
+	ue, ok := err.(*Error)
+	if !ok || ue.Kind != ErrModelBlocked {
+		t.Fatalf("primary 11102 must remain model_blocked: %v", err)
+	}
+}
