@@ -0,0 +1,51 @@
+package upstream
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"workbuddy2api/internal/auth"
+)
+
+const pathMetadataOriginal = "Tokens prefixed with @ are paths the user explicitly referenced. Relative paths resolve from the workspace root; absolute paths identify files or directories on the host."
+const pathMetadataCompatible = "Tokens prefixed with @ are paths the user explicitly referenced. Resolve relative paths from the workspace root; absolute paths identify files or directories on the host."
+
+func TestPathMetadataCompatibilityOnWire(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			body, _ := io.ReadAll(r.Body)
+			wanted := pathMetadataOriginal
+			if enabled {
+				wanted = pathMetadataCompatible
+			}
+			if !strings.Contains(string(body), wanted) || !strings.Contains(string(body), "Keep other instructions.") || !strings.Contains(string(body), "ordinary user text") {
+				t.Errorf("enabled=%v: request lost metadata or surrounding content: %s", enabled, body)
+			}
+			io.WriteString(w, "data: [DONE]\n\n")
+		}))
+		c := New()
+		c.ChatBaseCN = srv.URL
+		c.SanitizeFingerprints = enabled
+		a := &auth.Auth{UID: "u1", AccessToken: "test", ExpiresAt: 9999999999}
+		body := `{"model":"deepseek-v4.1-flash","messages":[{"role":"system","content":"Keep other instructions. ` + pathMetadataOriginal + `"},{"role":"user","content":"ordinary user text"}]}`
+		rc, _, _, err := c.ChatStream(a, []byte(body), "", ChatMeta{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		rc.Close()
+		srv.Close()
+	}
+}
+
+func TestPathMetadataRequiresCompleteParagraph(t *testing.T) {
+	short := "Relative paths resolve from the workspace root; absolute paths identify files or directories on the host."
+	if got := sanitizeText(short); got != short {
+		t.Fatalf("ordinary path sentence changed: %q", got)
+	}
+	if got := sanitizeText(pathMetadataOriginal); got != pathMetadataCompatible || sanitizeText(got) != got {
+		t.Fatalf("complete template must be rewritten once: %q", got)
+	}
+}
